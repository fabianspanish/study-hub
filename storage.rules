rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============ /avatars/{uid}.{ext} ============
    // Cada usuário só faz upload do PRÓPRIO avatar.
    // Leitura pública (avatares aparecem em vários lugares no app).
    match /avatars/{file} {
      // Lê pública (avatar é exibido no chip do header)
      allow read: if true;

      // Escrita: só o dono do avatar (uid no nome do arquivo)
      allow write: if request.auth != null
        && file.matches(request.auth.uid + '\\.(jpg|jpeg|png|webp|gif)')
        && request.resource.size < 2 * 1024 * 1024  // max 2MB
        && request.resource.contentType.matches('image/.*');
    }

    // Bloqueia tudo mais
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
